# ──────────────────────────────────────────────────────────────
# ML-Sentinel Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env
# ──────────────────────────────────────────────────────────────

# Application
APP_NAME=ML-Sentinel
APP_VERSION=2.0.0
ENVIRONMENT=development                # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# Security
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_KEYS=dev-key-abc123,dev-key-xyz789        # comma-separated
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=60

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=ml_sentinel_production
MLFLOW_MODEL_NAME=MLSentinelModel
MLFLOW_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Feast
FEAST_REPO_PATH=feast_repo
FEAST_TRACKING_URI=http://mlflow:5000

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://mlsentinel:mlsentinel@postgres:5432/mlsentinel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis (rate limiting / caching)
REDIS_URL=redis://redis:6379/0

# Airflow
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=
AIRFLOW__WEBSERVER__SECRET_KEY=some-random-airflow-secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
SLACK_WEBHOOK_URL=

# Serving
SERVING_HOST=0.0.0.0
SERVING_PORT=8000
MODEL_LOAD_TIMEOUT=30
PREDICTION_TIMEOUT=10

# Monitoring
DRIFT_REPORT_DIR=monitoring/reports
DRIFT_ALERT_THRESHOLD=0.4
