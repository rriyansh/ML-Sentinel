# ─────────────────────────────────────────────────────────────
# ML-Sentinel v3.0 Environment
# ─────────────────────────────────────────────────────────────
APP_NAME=ML-Sentinel
APP_VERSION=3.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────
SECRET_KEY=change-me-min-32-chars-random-string-xyz
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
API_KEYS=dev-key-abc123,dev-key-xyz789
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ── Encryption (PII at rest) ──────────────────────────────
ENCRYPTION_KEY=change-me-fernet-32-byte-base64-key-here==
PII_FIELDS=driver_id,email,phone

# ── Secrets backend: env | vault | aws | gcp ──────────────
SECRETS_BACKEND=env
VAULT_ADDR=
VAULT_TOKEN=
VAULT_SECRET_PATH=ml-sentinel

# ── MLflow ────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=ml_sentinel_production
MLFLOW_MODEL_NAME=MLSentinelModel
MLFLOW_ENABLE_OTEL=true

# ── Feast ─────────────────────────────────────────────────
FEAST_REPO_PATH=feast_repo
FEAST_TRACKING_URI=http://mlflow:5000

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://mlsentinel:mlsentinel@postgres:5432/mlsentinel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_STATEMENT_TIMEOUT_MS=30000

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_RATE_LIMIT_PREFIX=mls:rl:

# ── Serving ───────────────────────────────────────────────
SERVING_HOST=0.0.0.0
SERVING_PORT=8000
MODEL_LOAD_TIMEOUT=30
PREDICTION_TIMEOUT=10
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ── Observability ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=ml-sentinel-serving
OTEL_TRACES_SAMPLER_ARG=0.1
PROMETHEUS_MULTIPROC_DIR=/tmp/prom

# ── Monitoring ────────────────────────────────────────────
DRIFT_REPORT_DIR=monitoring/reports
DRIFT_ALERT_THRESHOLD=0.4
SHAP_BACKGROUND_SAMPLES=100
FAIRNESS_SENSITIVE_ATTRIBUTES=driver_id
FAIRNESS_MIN_DP_DIFF=0.1

# ── Airflow ───────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
SLACK_WEBHOOK_URL=
